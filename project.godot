; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Anomaly"
run/main_scene="res://#Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
FpsCounter="*res://fps_counter.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Anomaly"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom_font="res://#Assets/UI/Fonts/PortoBuena.otf"

[physics]

common/physics_ticks_per_second=144
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.08394208, 0.091926984, 0.076249294, 1)
