; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Anomaly"
run/main_scene="uid://dhu4vdo7bvbux"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://Other/icon.svg"
run/per_pixel_transparency/allowed=false

[autoload]

Keybinds="*res://#Scripts/Systems/Keybinds.cs"
PhantomCameraManager="*uid://duq6jhf6unyis"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/initial_position_type=0
window/size/initial_position=Vector2i(0, 200)
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Anomaly"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[file_customization]

folder_colors={
"res://#Assets/": "yellow",
"res://#Scenes/": "pink",
"res://#Scripts/": "blue",
"res://#Shaders/": "purple",
"res://Other/": "gray",
"res://addons/": "gray",
"res://data_Anomaly_windows_x86_64/": "gray"
}

