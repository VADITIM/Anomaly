{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet build Anomaly.csproj -nologo -v q -clp:ErrorsOnly >&2 || exit 2",
            "timeout": 300,
            "statusMessage": "Compiling..."
          }
        ]
      }
    ]
  }
}
